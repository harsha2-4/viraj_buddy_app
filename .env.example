OPENAI_API_KEY=
PORT=8080
HOST=127.0.0.1
# For deployment, set this to the exact HTTPS origin serving this app.
BUDDY_ORIGIN=http://localhost:8080
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=ash
OPENAI_REALTIME_NOISE_REDUCTION=near_field
OPENAI_REALTIME_VAD_THRESHOLD=0.7
OPENAI_REALTIME_VAD_PREFIX_PADDING_MS=300
OPENAI_REALTIME_VAD_SILENCE_DURATION_MS=1000
