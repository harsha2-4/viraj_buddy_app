# Server only. Keep real credentials in the host's secret manager.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=openai/gpt-oss-20b
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=troy
GROQ_STT_ENABLED=true
GROQ_LLM_ENABLED=true
GROQ_TTS_ENABLED=true
VOICE_VAD_ENABLED=true
VOICE_VAD_ABSOLUTE_THRESHOLD=0.012
VOICE_VAD_NOISE_MULTIPLIER=2.5
VOICE_NOISE_SUPPRESSION=true
VOICE_ECHO_CANCELLATION=true
VOICE_AUTO_GAIN_CONTROL=true
VOICE_MAX_UTTERANCE_MS=15000
VOICE_MAX_AUDIO_BYTES=20971520
VOICE_MIN_SPEECH_MS=200
VOICE_END_SILENCE_MS=1000
CONVERSATION_MEMORY_ENABLED=true
GROQ_REQUEST_TIMEOUT_MS=30000
GROQ_DAILY_SPEND_LIMIT_USD=5
GROQ_STT_COST_PER_HOUR_USD=0.04
GROQ_LLM_COST_PER_M_INPUT_USD=0.075
GROQ_LLM_COST_PER_M_OUTPUT_USD=0.30
GROQ_TTS_COST_PER_M_CHARS_USD=22
PORT=8080
HOST=127.0.0.1
BUDDY_ORIGIN=http://localhost:8080
